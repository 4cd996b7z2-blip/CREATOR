# Copy to .env.local for local work, or add these under Environment variables in Netlify / Vercel.

# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service_role-or-secret-key-here   # keep secret, server only

# Password for /admin (where you verify creators). Use 12+ characters.
ADMIN_PASSWORD=change-me-to-a-long-password

# Shown on the site. The Instagram account creators send their verification code to (without @).
NEXT_PUBLIC_SITE_NAME=Rajkot Creators
NEXT_PUBLIC_PLATFORM_IG=your_instagram_handle

# Optional
# NEXT_PUBLIC_DEFAULT_LANG=gu        # "gu" (default) or "en"
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# SESSION_SECRET=any-long-random-string   # defaults to a key derived from the service-role key

# Local testing without Supabase (ignored on any live host): fake data, resets on restart.
# USE_MOCK_DB=1
